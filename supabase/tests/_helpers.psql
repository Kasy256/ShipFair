-- Shared by every *.test.sql through `\ir _helpers.psql`. Runs inside the test's transaction, so
-- the schema and the users it creates are rolled back with it.

create schema tests;
grant usage on schema tests to anon, authenticated;

-- A signed-up user (the signup trigger makes the profile) with a known handle.
create function tests.create_user(handle text, role text default 'user')
returns uuid
language plpgsql
as $$
declare
  uid uuid := gen_random_uuid();
begin
  insert into auth.users (id, aud, role, email, raw_user_meta_data)
  values (uid, 'authenticated', 'authenticated', handle || '@test.local', jsonb_build_object('full_name', initcap(handle)));
  update public.profiles as p set handle = create_user.handle, role = create_user.role where p.id = uid;
  return uid;
end;
$$;

-- Become a signed-in user for the rest of the transaction, as PostgREST does for a request.
create function tests.login(uid uuid)
returns void
language sql
as $$
  select set_config('request.jwt.claims', json_build_object('sub', uid, 'role', 'authenticated')::text, true);
  select set_config('role', 'authenticated', true);
$$;

create function tests.logout_anon()
returns void
language sql
as $$
  select set_config('request.jwt.claims', json_build_object('role', 'anon')::text, true);
  select set_config('role', 'anon', true);
$$;

-- A booth inserted as postgres (skips the owner-only guard), e.g. an approved one.
create function tests.create_booth(owner uuid, slug text, status public.booth_status default 'approved')
returns uuid
language sql
as $$
  insert into public.booths (owner_id, slug, name, tagline, url, district_id, status, approved_at)
  values (
    owner, slug, initcap(slug), 'A test booth for policy tests', 'https://example.com/' || slug, 1,
    status, case when status = 'approved' then now() end
  )
  returning id;
$$;

grant execute on all functions in schema tests to anon, authenticated;

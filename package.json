{
  "name": "shipfair",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint:biome",
    "format": "biome check --write",
    "e2e": "turbo run e2e",
    "loadtest": "node tools/loadtest/run.ts",
    "lint:biome": "biome ci",
    "db:start": "node tools/db/start.mjs",
    "db:dev-vars": "node tools/db/write-dev-vars.mjs",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:lint": "supabase db lint --level warning --fail-on warning && pnpm db:check-rls",
    "db:types": "supabase gen types typescript --local > packages/shared/src/db.types.ts && biome check --write packages/shared/src/db.types.ts",
    "db:sync-blocklist": "node packages/shared/scripts/sync-blocklist.ts",
    "db:check-rls": "docker exec -i supabase_db_shipfair psql -U postgres -q -v ON_ERROR_STOP=1 < supabase/checks/rls.sql",
    "art:inspect": "node tools/blender/run.ts inspect",
    "art:characters": "node tools/blender/run.ts characters",
    "art:animations": "node tools/blender/run.ts animations",
    "art:wardrobe": "node tools/blender/run.ts wardrobe",
    "art:hair": "node tools/blender/run.ts hair",
    "art:ids": "node tools/blender/run.ts ids",
    "art:booth-kit": "node tools/blender/run.ts booth-kit",
    "art:props": "node tools/blender/run.ts props",
    "art:previews": "node tools/blender/run.ts previews",
    "art:build-all": "node tools/blender/run.ts build-all",
    "art:test": "node tools/blender/run.ts test",
    "assets:build": "node tools/assets/build.ts",
    "assets:palette": "node tools/assets/palette.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "supabase": "2.122.0",
    "turbo": "2.11.10",
    "typescript": "7.0.2"
  }
}

    "maskRules": [
      {
        "zone": "head",
        "patterns": ["^head$"]
      },
      {
        "zone": "neck",
        "patterns": ["^neck_\\d+$"]
      },
      {
        "zone": "hand",
        "patterns": ["^hand_[lr]$", "^(thumb|index|middle|ring|pinky)_\\d+(_leaf)?_[lr]$"]
      },
      {
        "zone": "forearm",
        "patterns": ["^lowerarm_[lr]$"]
      },
      {
        "zone": "upperarm",
        "patterns": ["^upperarm_[lr]$"]
      },
      {
        "zone": "torso",
        "patterns": ["^spine_\\d+$", "^clavicle_[lr]$"]
      },
      {
        "zone": "hips",
        "patterns": ["^pelvis$", "^root$"]
      },
      {
        "zone": "thigh",
        "patterns": ["^thigh_[lr]$"]
      },
      {
        "zone": "calf",
        "patterns": ["^calf_[lr]$"]
      },
      {
        "zone": "foot",
        "patterns": ["^foot_[lr]$", "^ball(_leaf)?_[lr]$"]
      }
    ],
    "maskSplits": [
      {
        "zone": "upperarm_lo",
        "from": "upperarm",
        "plane": {
          "from": "upperarm_{s}",
          "to": "lowerarm_{s}",
          "t": 0.5
        },
        "why": "short sleeves end halfway down the upper arm"
      },
      {
        "zone": "knee",
        "from": "thigh",
        "plane": {
          "from": "thigh_{s}",
          "to": "calf_{s}",
          "t": 0.55
        },
        "why": "shorts end above the knee"
      },
      {
        "zone": "calf_lo",
        "from": "calf",
        "plane": {
          "from": "calf_{s}",
          "to": "foot_{s}",
          "fromEndM": 0.12
        },
        "why": "boots cover the lowest 12 cm of the calf"
      },
      {
        "zone": "shoulder",
        "from": "torso",
        "plane": {
          "from": "clavicle_{s}",
          "to": "upperarm_{s}",
          "t": 0.6,
          "radiusM": 0.15
        },
        "why": "a tank top's arm holes reach under the arm"

# ---------- Web app (public, baked into the browser bundle) ----------
VITE_APP_URL=http://localhost:5173
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
VITE_REALTIME_HOST=localhost:1999
VITE_MEDIA_HOST=   # leave empty locally: the dev Worker serves approved media on the page origin
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA   # Cloudflare's always-pass test key
VITE_SENTRY_DSN=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# ---------- web Worker secrets (put in apps/web/.dev.vars locally; `wrangler secret put` in envs) ----------
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
TURNSTILE_SECRET=1x0000000000000000000000000000000AA   # always-pass test secret
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=shipfair-media-dev
STATS_INGEST_SECRET=change-me-local
MODERATION_API_KEY=
SAFE_BROWSING_KEY=
MIN_ACCOUNT_AGE_MINUTES=0   # local default only; the live value is the DB feature flag (prompt 09)

# ---------- realtime Worker (apps/realtime/.dev.vars) ----------
SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
STATS_INGEST_SECRET=change-me-local   # second layer on the ingestStats RPC (service binding)
MAX_PLAYERS_PER_SHARD=60

# ---------- local Supabase (read by `supabase start`; export in your shell) ----------
# GitHub/Google sign-in is off locally unless these are set. Email + password exists locally only.
SUPABASE_AUTH_EXTERNAL_GITHUB_ENABLED=false
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=
SUPABASE_AUTH_EXTERNAL_GOOGLE_ENABLED=false
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

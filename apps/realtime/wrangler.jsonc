{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "shipfair-realtime",
  "main": "./src/index.ts",
  // Held back for @cloudflare/vitest-pool-workers 0.23 (TECH_STACK.md "Known version constraints").
  "compatibility_date": "2026-08-15",
  // AsyncLocalStorage for @sentry/cloudflare (per-request scopes). Nothing else from Node.
  "compatibility_flags": ["nodejs_als"],
  // Workers Logs: console output (JSON lines from crons and shards) kept and searchable.
  "observability": { "enabled": true },
  // STATS_INGEST_SECRET is a secret: `.dev.vars` locally (`pnpm db:dev-vars` writes the same value
  // for web), `wrangler secret put STATS_INGEST_SECRET --env <env>` in staging and production.
  // MAX_PLAYERS_PER_SHARD, AOI_RADIUS_M and CHAT_RADIUS_M may be set for load tests only.
  "vars": {
    "ENVIRONMENT": "development",
    "SUPABASE_JWKS_URL": "http://127.0.0.1:54321/auth/v1/.well-known/jwks.json"
  },
  // Binding names map to PartyServer paths: /parties/coordinator/:id and /parties/world-shard/:id.
  "durable_objects": {
    "bindings": [
      { "name": "Coordinator", "class_name": "Coordinator" },
      { "name": "WorldShard", "class_name": "WorldShard" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Coordinator", "WorldShard"] }],
  // RPC to the web Worker. Locally this resolves through wrangler's dev registry.
  "services": [{ "binding": "WEB", "service": "shipfair-web", "entrypoint": "WebRpc" }],
  // SUPABASE_JWKS_URL (`https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json`),
  // SENTRY_DSN and RELEASE for staging and production are passed with `--var` by the deploy
  // workflows; without the JWKS URL the shard refuses to start with a RealtimeEnv error.
  "env": {
    "staging": {
      "vars": { "ENVIRONMENT": "staging" },
      "routes": [{ "pattern": "rt-staging.shipfair.xyz", "custom_domain": true }],
      "durable_objects": {
        "bindings": [
          { "name": "Coordinator", "class_name": "Coordinator" },
          { "name": "WorldShard", "class_name": "WorldShard" }
        ]
      },
      "services": [{ "binding": "WEB", "service": "shipfair-web-staging", "entrypoint": "WebRpc" }]
    },
    // No public DNS yet: workers.dev until launch, then the `rt.shipfair.xyz` custom domain.
    "production": {
      "vars": { "ENVIRONMENT": "production" },
      "workers_dev": true,
      "durable_objects": {
        "bindings": [
          { "name": "Coordinator", "class_name": "Coordinator" },
          { "name": "WorldShard", "class_name": "WorldShard" }
        ]
      },
      "services": [
        { "binding": "WEB", "service": "shipfair-web-production", "entrypoint": "WebRpc" }
      ]
    }
  }
}

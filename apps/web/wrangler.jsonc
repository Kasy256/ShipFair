{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "shipfair-web",
  "main": "./worker/index.ts",
  // Held back for @cloudflare/vitest-pool-workers 0.23 (TECH_STACK.md "Known version constraints").
  "compatibility_date": "2026-08-15",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/b/*"]
  },
  "vars": {
    "ENVIRONMENT": "development",
    // Local Supabase. SUPABASE_ANON_KEY is per machine: `pnpm db:start` writes it to .dev.vars.
    "SUPABASE_URL": "http://127.0.0.1:54321"
  },
  // World cache version. No id: wrangler provisions the namespace on first deploy (prompt 15).
  "kv_namespaces": [{ "binding": "KV" }],
  // RPC to the realtime Worker. Locally this resolves through wrangler's dev registry.
  "services": [
    { "binding": "REALTIME", "service": "shipfair-realtime", "entrypoint": "RealtimeRpc" }
  ],
  // Names only for now. Routes, R2, SUPABASE_* values and secrets arrive with prompt 15.
  "env": {
    "staging": {
      "vars": { "ENVIRONMENT": "staging" },
      "kv_namespaces": [{ "binding": "KV" }],
      "services": [
        {
          "binding": "REALTIME",
          "service": "shipfair-realtime-staging",
          "entrypoint": "RealtimeRpc"
        }
      ]
    },
    "production": {
      "vars": { "ENVIRONMENT": "production" },
      "kv_namespaces": [{ "binding": "KV" }],
      "services": [
        {
          "binding": "REALTIME",
          "service": "shipfair-realtime-production",
          "entrypoint": "RealtimeRpc"
        }
      ]
    }
  }
}
